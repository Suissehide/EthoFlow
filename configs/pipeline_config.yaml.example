# Configuration globale du pipeline EthoFlow.
# Copier ce fichier en `pipeline_config.yaml` (sans .example) et adapter.

# Chemin absolu vers le fichier config.yaml du projet DeepLabCut entraîné.
# Exemple Windows :
#   dlc_project_config: C:\labo\dlc-projects\souris-openfield-2026-XX-XX\config.yaml
# Exemple Mac/Linux :
#   dlc_project_config: /home/user/dlc-projects/souris-openfield-2026-XX-XX/config.yaml
dlc_project_config: /CHEMIN/VERS/dlc-projects/souris-openfield-XXXX/config.yaml

# Chemin absolu vers le fichier config.yaml du projet VAME initialisé.
vame_project_config: /CHEMIN/VERS/vame-projects/souris-openfield-XXXX/config.yaml

# Coordonnées par défaut des 4 arènes (vidéo source 1024×1080, grille 2×2).
# Format : [x, y, w, h] en pixels. À ajuster avec la géométrie réelle du setup.
# Sont utilisées comme fallback si une session n'a pas de coords définies.
default_arenes_coords:
  A1: [0, 0, 512, 540]
  A2: [512, 0, 512, 540]
  A3: [0, 540, 512, 540]
  A4: [512, 540, 512, 540]
